# Maintainer: HWG90
pkgname=ludo-git
pkgver=0.1.9.r0.g0000000
pkgrel=1
pkgdesc="Terminal Linux guide for people coming from Windows"
arch=('any')
url="https://github.com/HWG90/ludo"
license=('MIT')
depends=('python>=3.11')
makedepends=('git' 'python-pip' 'python-wheel' 'python-setuptools')
provides=('ludo')
conflicts=('ludo')
source=("git+${url}.git")
sha256sums=('SKIP')

pkgver() {
  cd ludo
  printf "0.1.9.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

package() {
  cd ludo
  python -m pip install --root="$pkgdir" --prefix=/usr --no-warn-script-location .
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
