Screen {
    background: $background;
    color: $foreground;
}

Header {
    background: $panel;
    color: $foreground;
    text-style: bold;
}

Footer {
    background: $panel;
}

#sidebar {
    width: 26;
    height: 1fr;
    background: $surface;
    border-right: tall $border-blurred;
    padding: 1 1;
}

#brand {
    color: $text-primary;
    text-style: bold;
    padding: 0 1 1 1;
}

#brand-sub {
    color: $foreground-muted;
    padding: 0 1 1 1;
}

Button.nav {
    width: 100%;
    border: none;
    background: $surface;
    color: $foreground-muted;
    text-align: left;
    margin: 0 0 1 0;
}

Button.nav:hover {
    background: $boost;
    color: $foreground;
}

Button.nav.-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

#main {
    width: 1fr;
    height: 1fr;
}

#body {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

HomeView, WeekView, GlossaryView, GamingView, CheckupView, CommandsView, ChatView {
    height: 1fr;
}

ChatView {
    overflow-y: hidden;
}

#ask-bar {
    height: 3;
    width: 100%;
    background: $panel;
    border-top: tall $primary;
    padding: 0 1;
    align: left middle;
}

#ask-label {
    width: 6;
    color: $text-primary;
    text-style: bold;
    content-align: center middle;
}

#ask-input {
    width: 1fr;
    background: $background;
    border: tall $border-blurred;
}

#chat-log {
    height: 1fr;
    min-height: 0;
    margin-top: 1;
    background: $surface;
    border: round $border-blurred;
    padding: 1 2;
    overflow-y: auto;
}

#glossary-results, #cmd-results, #week-list {
    height: 1fr;
    margin-top: 1;
}

.card {
    background: $surface;
    border: round $border-blurred;
    padding: 1 2;
    margin-bottom: 1;
}

.card-title {
    text-style: bold;
    color: $foreground;
}

.muted {
    color: $foreground-muted;
}

.gold {
    color: $text-primary;
    text-style: bold;
}

.good {
    color: $text-success;
}

.next {
    color: $text-warning;
}

.warn {
    color: $text-error;
}

.fact-key {
    width: 16;
    color: $text-primary;
    text-style: bold;
}

.hero {
    height: auto;
    padding: 1 1 2 1;
}

Input {
    background: $surface;
    border: tall $border-blurred;
}

ListView {
    background: $surface;
    border: round $border-blurred;
    height: 1fr;
}

ListItem {
    padding: 0 1;
}

.md-wrap {
    height: 1fr;
    background: $surface;
    border: round $border-blurred;
    padding: 1 2;
}

Button.primary {
    background: $primary;
    color: $text;
    border: none;
    text-style: bold;
}

Button.ghost {
    background: $boost;
    color: $foreground;
    border: none;
}

#setup-card {
    width: 72;
    height: auto;
    max-height: 28;
    background: $surface;
    border: round $primary;
    padding: 1 2;
}

SetupScreen, OllamaSetupScreen {
    align: center middle;
    background: $background 60%;
}

#setup-copy {
    margin: 1 0;
}

#setup-actions {
    height: auto;
    margin-top: 1;
}

#setup-status {
    margin-top: 1;
    min-height: 1;
}
