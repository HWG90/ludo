Screen {
    background: #12110e;
    color: #f0e6d8;
}

Header {
    background: #1c1916;
    color: #f5e6c8;
    text-style: bold;
}

Footer {
    background: #1c1916;
}

#sidebar {
    width: 26;
    height: 1fr;
    background: #191613;
    border-right: tall #3a3226;
    padding: 1 1;
}

#brand {
    color: #c9a227;
    text-style: bold;
    padding: 0 1 1 1;
}

#brand-sub {
    color: #8a7d6b;
    padding: 0 1 1 1;
}

Button.nav {
    width: 100%;
    border: none;
    background: #191613;
    color: #c4b5a0;
    text-align: left;
    margin: 0 0 1 0;
}

Button.nav:hover {
    background: #2a241c;
    color: #f5e6c8;
}

Button.nav.-active {
    background: #c9a227;
    color: #1a1408;
    text-style: bold;
}

#body {
    width: 1fr;
    height: 1fr;
    padding: 1 2;
}

HomeView, WeekView, GlossaryView, GamingView, CheckupView, CommandsView {
    height: 1fr;
}

#glossary-results, #cmd-results, #week-list {
    height: 1fr;
    margin-top: 1;
}

.card {
    background: #1c1916;
    border: round #3a3226;
    padding: 1 2;
    margin-bottom: 1;
}

.card-title {
    text-style: bold;
    color: #f5e6c8;
}

.muted {
    color: #8a7d6b;
}

.gold {
    color: #c9a227;
    text-style: bold;
}

.good {
    color: #8fbf88;
}

.next {
    color: #e6c36a;
}

.warn {
    color: #e09080;
}

.fact-key {
    width: 16;
    color: #c9a227;
    text-style: bold;
}

.hero {
    height: auto;
    padding: 1 1 2 1;
}

Input {
    background: #1c1916;
    border: tall #3a3226;
}

ListView {
    background: #1c1916;
    border: round #3a3226;
    height: 1fr;
}

ListItem {
    padding: 0 1;
}

.md-wrap {
    height: 1fr;
    background: #1c1916;
    border: round #3a3226;
    padding: 1 2;
}

Button.primary {
    background: #c9a227;
    color: #1a1408;
    border: none;
    text-style: bold;
}

Button.ghost {
    background: #2a241c;
    color: #f5e6c8;
    border: none;
}

#quiz-box {
    background: #1c1916;
    border: round #3a3226;
    padding: 1 2;
    margin-top: 1;
    height: auto;
}
